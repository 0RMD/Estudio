  "frases": [
    {
      "n": 1,
      "texto": "¿Por qué posponer la alarma 5 minutos te deja cansado todo el día?",
      "clave": "cansado",
      "inicio": 0,
      "fin": 3.92
    },
    {
      "n": 2,
      "texto": "Al volver a dormirte, tu cerebro inicia un ciclo nuevo y baja más profundo.",
      "clave": "profundo",
      "inicio": 4.4,
      "fin": 8.8
    },
    {
      "n": 3,
      "texto": "Cortarlo de golpe a los 5 minutos te deja aturdido durante horas.",
      "clave": "aturdido",
      "inicio": 9.28,
      "fin": 13.24
    },
    {
      "n": 4,
      "texto": "Usa una sola alarma. Envíaselo a ese amigo que pone diez seguidas.",
