{
  "firma": "0616390185f0",
  "duracion": 55.2,
  "frases": [
    {
      "n": 1,
      "texto": "¿Sabías que la carga rápida original no daña tu celular, pero un cable barato sí puede quemarlo por dentro?",
      "clave": "cable",
      "inicio": 0,
      "fin": 6.16
    },
    {
      "n": 2,
      "texto": "Por fuera los dos cables se ven iguales, pero por dentro uno viene vacío.",
      "clave": "vacío",
      "inicio": 6.2,
      "fin": 10.44
    },
    {
      "n": 3,
      "texto": "El cable original trae un microchip que negocia el voltaje exacto con tu celular.",
      "clave": "microchip",
      "inicio": 10.64,
      "fin": 14.96
    },
    {
      "n": 4,
      "texto": "Carga rápido hasta el 80 % y frena solo para no calentar la batería.",
      "clave": "frena",
      "inicio": 15.12,
      "fin": 19.84
    },
    {
      "n": 5,
      "texto": "En cambio, el cable barato no trae chip y usa hilos de cobre finísimos.",
      "clave": "cobre",
      "inicio": 19.92,
      "fin": 24.32
    },
    {
      "n": 6,
      "texto": "Es como meter toda el agua de tu casa por un tubo finito sin válvula: la unión revienta.",
      "clave": "válvula",
      "inicio": 24.48,
      "fin": 29.92
    },
    {
      "n": 7,
      "texto": "Sin control, la corriente calienta los pines del puerto y quema el chip de carga interior.",
      "clave": "quema",
      "inicio": 30.08,
      "fin": 34.8
    },
    {
      "n": 8,
      "texto": "Por eso la punta quema al tocarla y tu celular solo carga cuando doblas el cable.",
      "clave": "doblas",
      "inicio": 34.96,
      "fin": 39.52
    },
    {
      "n": 9,
      "texto": "Para evitarlo, usa cables certificados y desconéctalo de inmediato si la punta se calienta.",
      "clave": "certificados",
      "inicio": 39.56,
      "fin": 44.72
    },
    {
      "n": 10,
      "texto": "Envíaselo a ese amigo que siempre compra el cable más barato de la esquina.",
      "clave": "amigo",
      "inicio": 44.8,
      "fin": 48.68
    },
    {
      "n": 11,
      "texto": "Y mañana, episodio tres: dónde quedan de verdad las fotos que borras de tu celular.",
      "clave": "fotos",
      "inicio": 48.96,
      "fin": 54.4
    }
  ],
