    {
      "n": 1,
      "texto": "¿Sabías que lavar los platos a mano gasta 4 veces más agua?",
      "clave": "agua",
      "inicio": 0,
      "fin": 3.76
    },
    {
      "n": 2,
      "texto": "Con la llave abierta se van 50 litros limpios directo al desagüe.",
      "clave": "desagüe",
      "inicio": 4.16,
      "fin": 8.32
    },
    {
      "n": 3,
      "texto": "El lavavajillas llena solo 12 litros y los recicla calientes una y otra vez.",
      "clave": "recicla",
      "inicio": 8.36,
      "fin": 13.28
    },
    {
      "n": 4,
      "texto": "Envíaselo a ese amigo que lava a mano para ahorrar agua.",
