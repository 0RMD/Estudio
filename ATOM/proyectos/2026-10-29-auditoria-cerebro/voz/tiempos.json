  "frases": [
    {
      "n": 1,
      "texto": "Tu cerebro consume la quinta parte de toda tu energia.",
      "clave": "quinta",
      "inicio": 0,
      "fin": 3.76
    },
    {
      "n": 2,
      "texto": "Pesa poco, pero gasta como una bombilla encendida todo el dia.",
      "clave": "bombilla",
      "inicio": 3.84,
      "fin": 7.92
    },
    {
      "n": 3,
      "texto": "Cuando piensas mucho, no gasta mucho mas.",
      "clave": "mas",
      "inicio": 7.96,
      "fin": 10.64
    },
    {
      "n": 4,
      "texto": "El gasto grande es mantenerlo vivo.",
      "clave": "vivo",
      "inicio": 10.72,
      "fin": 13.2
    },
    {
      "n": 5,
      "texto": "Por eso nunca descansa de verdad.",
      "clave": "descansa",
      "inicio": 13.24,
      "fin": 15.28
    }
  ],
