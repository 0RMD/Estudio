  "frases": [
    {
      "n": 1,
      "texto": "¿Por qué tomar café apenas despiertas te da más sueño a mediodía?",
      "clave": "mediodía",
      "inicio": 0,
      "fin": 3.92
    },
    {
      "n": 2,
      "texto": "Al levantarte, tu cuerpo ya enciende solo su pico natural de energía.",
      "clave": "energía",
      "inicio": 4.16,
      "fin": 8.48
    },
    {
      "n": 3,
      "texto": "El café solo tapa el cansancio como un corcho, y a mediodía salta de golpe.",
      "clave": "corcho",
      "inicio": 8.72,
      "fin": 13.6
    },
    {
      "n": 4,
      "texto": "Espera 90 minutos al despertar. Envíaselo a ese amigo que vive con sueño.",
      "clave": "minutos",
      "inicio": 13.84,
      "fin": 18.64
    }
  ],
