{
  "firma": "5c292a2ab135",
  "duracion": 61.04,
  "frases": [
    {
      "n": 1,
      "texto": "¿Sabías que un celular de 200 megapíxeles puede tomar peores fotos de noche que uno de 48?",
      "clave": "noche",
      "inicio": 0,
      "fin": 6.32
    },
    {
      "n": 2,
      "texto": "Las marcas presumen el número gigante en la caja, pero esconden el tamaño del sensor.",
      "clave": "sensor",
      "inicio": 6.4,
      "fin": 11.2
    },
    {
      "n": 3,
      "texto": "Como el sensor del celular es pequeño, meter 200 millones de píxeles los vuelve diminutos.",
      "clave": "diminutos",
      "inicio": 11.44,
      "fin": 16.88
    },
    {
      "n": 4,
      "texto": "Con buen sol sobra luz y cada puntito logra una foto llena de detalle.",
      "clave": "sol",
      "inicio": 17.12,
      "fin": 21.44
    },
    {
      "n": 5,
      "texto": "Pero de noche falta luz: un píxel minúsculo casi no atrapa nada y saca ruido.",
      "clave": "ruido",
      "inicio": 21.84,
      "fin": 26.96
    },
    {
      "n": 6,
      "texto": "Es como salir bajo una llovizna con 200 dedales finitos en vez de 12 baldes anchos.",
      "clave": "baldes",
      "inicio": 27.36,
      "fin": 32.48
    },
    {
      "n": 7,
      "texto": "Por eso de noche ese mismo celular une 16 píxeles en uno y dispara a solo 12 megapíxeles.",
      "clave": "une",
      "inicio": 32.88,
      "fin": 38.96
    },
    {
      "n": 8,
      "texto": "Lo que mejora tus fotos nocturnas no son más megapíxeles: es un sensor físico más grande.",
      "clave": "grande",
      "inicio": 39.36,
      "fin": 44.96
    },
    {
      "n": 9,
      "texto": "Al elegir celular, busca el tamaño físico del sensor antes de pagar por más megapíxeles.",
      "clave": "elegir",
      "inicio": 45.2,
      "fin": 50.32
    },
    {
      "n": 10,
      "texto": "Envíaselo a ese amigo que compra celular mirando solo cuántos megapíxeles dice la caja.",
      "clave": "amigo",
      "inicio": 50.72,
      "fin": 55.44
    },
    {
      "n": 11,
      "texto": "Y entra a mi perfil para ver los cuatro episodios completos de Mitos de tu Celular.",
      "clave": "perfil",
      "inicio": 55.68,
      "fin": 60.24
    }
  ],
